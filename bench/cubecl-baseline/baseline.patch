+//! Paired A100 benchmark harness for the CubeCL baseline (slice F, unit U6).
+//!
+//! This module is added by `bench/cubecl-baseline/baseline.patch` of
+//! `t4a-cuda-kernels` and is not part of the shipped crate. It calls the
+//! private CubeCL launchers directly with the frozen case list of
+//! `docs/design/slice-complete-port.md` §7 as amended by §11 items 7-9, so the
+//! candidate (`examples/bench_kernels.rs` in `t4a-cuda-kernels`) runs a matched
+//! kernel sequence.
+//!
+//! Every case is reachable through `T4A_BENCH_CASES` (a comma-separated list of
+//! case names, or `all`). `run-paired.sh` runs one case per process so
+//! `nsys --capture-range=cudaProfilerApi` delimits exactly one case.
+//!
+//! Protocol per case: 10 warm-ups outside the capture range, `cuProfilerStart`,
+//! 100 timed iterations, one barrier at the observation boundary,
+//! `cuProfilerStop`. Host work is single-threaded. Buffers and metadata are
+//! prepared before the capture range, so the measured region performs no
+//! transfer, no device allocation, no zero fill and no host wait per iteration.
+//! The fusion cases allocate their outputs inside the baseline's own launcher;
+//! that is reported in the `BENCH_META` line, not hidden.
+
+#![allow(clippy::too_many_arguments)]
+
+use std::ffi::c_void;
+
+use cubecl::prelude::{BufferArg, CubeCount, CubeDim, TensorBinding};
+use cubecl_runtime::server::Handle;
+use num_complex::Complex64;
+
+use super::dispatch::{comptime_sequence, cube_count_for_len, cube_dim_1d, runtime_sequence};
+use super::fusion;
+use crate::kernels;
+use super::runtime::CudaRuntime;
+use super::CudaBackend;
+
+use crate::backend::{ElementwiseFusionInst, ElementwiseFusionOp, ElementwiseFusionPlan};
+use crate::{DType, Tensor, TypedTensor};
+
+const WARMUPS: usize = 10;
+const ITERS: usize = 100;
+
+// ---------------------------------------------------------------------------
+// CUDA profiler range
+// ---------------------------------------------------------------------------
+
+struct Profiler {
+    start: unsafe extern "C" fn(u32) -> i32,
+    stop: unsafe extern "C" fn(u32) -> i32,
+}
+
+extern "C" {
+    fn dlopen(filename: *const i8, flag: i32) -> *mut c_void;
+    fn dlsym(handle: *mut c_void, symbol: *const i8) -> *mut c_void;
+}
+
+fn profiler() -> &'static Profiler {
+    static PROFILER: std::sync::OnceLock<Profiler> = std::sync::OnceLock::new();
+    PROFILER.get_or_init(|| unsafe {
+        let handle = dlopen(c"libcuda.so.1".as_ptr(), 1);
+        assert!(!handle.is_null(), "libcuda.so.1 not loadable");
+        let resolve = |symbol: &std::ffi::CStr| -> *mut c_void {
+            let pointer = dlsym(handle, symbol.as_ptr());
+            assert!(!pointer.is_null(), "driver profiler symbol missing");
+            pointer
+        };
+        Profiler {
+            start: std::mem::transmute::<*mut c_void, unsafe extern "C" fn(u32) -> i32>(resolve(
+                c"cuProfilerStart",
+            )),
+            stop: std::mem::transmute::<*mut c_void, unsafe extern "C" fn(u32) -> i32>(resolve(
+                c"cuProfilerStop",
+            )),
+        }
+    })
+}
+
+fn profile_start() {
+    // SAFETY: the driver entry point takes the CUDA context (0 = current); the
+    // runtime has already made its primary context current on this thread.
+    let status = unsafe { (profiler().start)(0) };
+    assert_eq!(status, 0, "cuProfilerStart failed with {status}");
+}
+
+fn profile_stop() {
+    let status = unsafe { (profiler().stop)(0) };
+    assert_eq!(status, 0, "cuProfilerStop failed with {status}");
+}
+
+// ---------------------------------------------------------------------------
+// Case bookkeeping
+// ---------------------------------------------------------------------------
+
+struct Meta {
+    kernels: &'static str,
+    launches: usize,
+    scratch_bytes: usize,
+    allocations: usize,
+    zero_fills: usize,
+}
+
+impl Meta {
+    fn simple(kernels: &'static str) -> Meta {
+        Meta {
+            kernels,
+            launches: 1,
+            scratch_bytes: 0,
+            allocations: 0,
+            zero_fills: 0,
+        }
+    }
+}
+
+fn emit_meta(case: &str, meta: &Meta, check: &str, extra: &str) {
+    println!(
+        "BENCH_META case={case} kernels={} launches_per_iter={} scratch_bytes={} \
+         host_waits_per_iter=0 transfer_bytes_per_iter=0 device_allocations_per_iter={} \
+         zero_fills_per_iter={} boundary_barriers=1 check={check} {extra}",
+        meta.kernels, meta.launches, meta.scratch_bytes, meta.allocations, meta.zero_fills
+    );
+}
+
+fn wanted(case: &str) -> bool {
+    match std::env::var("T4A_BENCH_CASES") {
+        Err(_) => true,
+        Ok(value) => value
+            .split(',')
+            .map(str::trim)
+            .any(|entry| entry == case || entry == "all"),
+    }
+}
+
+/// The frozen protocol: warm-ups outside the capture range, then 100 timed
+/// iterations inside it.
+fn measure(rt: &CudaRuntime, run: &mut impl FnMut()) {
+    for _ in 0..WARMUPS {
+        run();
+    }
+    rt.synchronize().expect("warm-up synchronize");
+    profile_start();
+    for _ in 0..ITERS {
+        run();
+    }
+    // The single barrier at the observation boundary: without it the capture
+    // range could close before the queued iterations execute.
+    rt.synchronize().expect("measured synchronize");
+    profile_stop();
+}
+
+// ---------------------------------------------------------------------------
+// Plumbing
+// ---------------------------------------------------------------------------
+
+fn backend() -> CudaBackend {
+    let devices = crate::cuda::cuda_devices().expect("CUDA device discovery");
+    let device = devices.first().expect("at least one CUDA device");
+    CudaBackend::new(device.id()).expect("CUDA backend")
+}
+
+fn client(backend: &CudaBackend) -> &cubecl::client::Client {
+    backend.runtime().client()
+}
+
+fn bytes_of<T: Copy>(values: &[T]) -> &[u8] {
+    // SAFETY: every type used here is a plain scalar or a repr(C) pair of
+    // scalars, so its byte image is well defined.
+    unsafe {
+        std::slice::from_raw_parts(values.as_ptr().cast::<u8>(), std::mem::size_of_val(values))
+    }
+}
+
+fn typed<T: Copy>(bytes: &[u8]) -> Vec<T> {
+    let size = std::mem::size_of::<T>();
+    assert_eq!(bytes.len() % size, 0);
+    let mut values: Vec<T> = Vec::with_capacity(bytes.len() / size);
+    // SAFETY: the capacity matches the byte length, and any bit pattern is a
+    // valid value for the plain scalar types used here.
+    unsafe {
+        std::ptr::copy_nonoverlapping(bytes.as_ptr(), values.as_mut_ptr().cast::<u8>(), bytes.len());
+        values.set_len(bytes.len() / size);
+    }
+    values
+}
+
+fn read<T: Copy>(client: &cubecl::client::Client, handle: &Handle, count: usize) -> Vec<T> {
+    let bytes = client.read_one(handle.clone()).expect("device read");
+    typed::<T>(&bytes[..count * std::mem::size_of::<T>()])
+}
+
+fn upload<T: Copy>(client: &cubecl::client::Client, values: &[T]) -> Handle {
+    client.create_from_slice(bytes_of(values))
+}
+
+fn flat(len: usize) -> (CubeCount, CubeDim) {
+    (cube_count_for_len(len).expect("flat cube count"), cube_dim_1d())
+}
+
+fn arg(handle: &Handle, len: usize) -> BufferArg {
+    // SAFETY: the caller passes the logical element count of its own buffer.
+    unsafe { BufferArg::from_raw_parts(handle.clone(), len) }
+}
+
+fn binding(handle: &Handle, shape: &[usize], strides: &[usize]) -> TensorBinding {
+    // SAFETY: the caller passes the logical shape and element strides of its
+    // own buffer; CubeCL only uses them to index the handle.
+    unsafe {
+        TensorBinding::from_raw_parts(
+            handle.clone(),
+            strides.to_vec().into(),
+            shape.to_vec().into(),
+        )
+    }
+}
+
+fn compact_strides(shape: &[usize]) -> Vec<usize> {
+    let mut strides = Vec::with_capacity(shape.len());
+    let mut stride = 1usize;
+    for &extent in shape {
+        strides.push(stride);
+        stride *= extent;
+    }
+    strides
+}
+
+struct Rng(u64);
+
+impl Rng {
+    fn new(seed: u64) -> Rng {
+        Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1)
+    }
+
+    fn next_u64(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x << 13;
+        x ^= x >> 7;
+        x ^= x << 17;
+        self.0 = x;
+        x
+    }
+
+    fn f32(&mut self) -> f32 {
+        (self.next_u64() >> 40) as f32 / (1u64 << 24) as f32 - 0.5
+    }
+
+    fn f64(&mut self) -> f64 {
+        (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64 - 0.5
+    }
+
+    fn c64(&mut self) -> Complex64 {
+        Complex64::new(self.f64() * 4.0, self.f64() * 4.0)
+    }
+
+    fn i32(&mut self) -> i32 {
+        (self.next_u64() % 2_000_001) as i32 - 1_000_000
+    }
+}
+
+fn samples(len: usize, stride: usize) -> Vec<usize> {
+    let mut points = vec![0, 1, 2, len / 3, len / 2, len - 2, len - 1];
+    let mut index = 3;
+    while index + 4 < len {
+        points.push(index);
+        index = index.saturating_add(stride);
+    }
+    points.retain(|&point| point < len);
+    points.sort_unstable();
+    points.dedup();
+    points
+}
+
+fn close_f32(actual: f32, expected: f32) -> bool {
+    if actual == expected {
+        return true;
+    }
+    if !actual.is_finite() || !expected.is_finite() {
+        return false;
+    }
+    (actual - expected).abs() <= 1e-4 * expected.abs().max(1.0)
+}
+
+fn close_f64(actual: f64, expected: f64) -> bool {
+    if actual == expected {
+        return true;
+    }
+    if !actual.is_finite() || !expected.is_finite() {
+        return false;
+    }
+    (actual - expected).abs() <= 1e-9 * expected.abs().max(1.0)
+}
+
+/// A floating sum is compared against the accumulated magnitude, so a tree
+/// reduction and a serial reference agree without a bitwise promise.
+fn close_sum(actual: f64, expected: f64, abs_sum: f64) -> bool {
+    if actual == expected {
+        return true;
+    }
+    if !actual.is_finite() || !expected.is_finite() {
+        return false;
+    }
+    (actual - expected).abs() <= 1e-5 * abs_sum + 1e-6
+}
+
+fn checked(outcome: bool, case: &str) {
+    assert!(outcome, "reference check failed for {case}");
+}
+
+// ---------------------------------------------------------------------------
+// Elementwise
+// ---------------------------------------------------------------------------
+
+fn run_add_f32(case: &str, len: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let mut rng = Rng::new(len as u64);
+    let lhs: Vec<f32> = (0..len).map(|_| rng.f32()).collect();
+    let rhs: Vec<f32> = (0..len).map(|_| rng.f32()).collect();
+    let lhs_h = upload(client, &lhs);
+    let rhs_h = upload(client, &rhs);
+    let out_h = client.empty(len * 4);
+    let (count, dim) = flat(len);
+    let mut run = || unsafe {
+        kernels::elementwise::add_float::launch_unchecked::<f32>(
+            client,
+            count.clone(),
+            dim,
+            arg(&out_h, len),
+            arg(&lhs_h, len),
+            arg(&rhs_h, len),
+        );
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<f32>(client, &out_h, len);
+    checked(
+        samples(len, 65_537)
+            .into_iter()
+            .all(|index| close_f32(got[index], lhs[index] + rhs[index])),
+        case,
+    );
+    measure(backend.runtime(), &mut run);
+    emit_meta(case, &Meta::simple("add_float"), "ok", "");
+}
+
+fn run_exp_f32(case: &str, len: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let mut rng = Rng::new(0x5F5F_5555);
+    let input: Vec<f32> = (0..len).map(|_| rng.f32()).collect();
+    let input_h = upload(client, &input);
+    let out_h = client.empty(len * 4);
+    let (count, dim) = flat(len);
+    let mut run = || unsafe {
+        kernels::elementwise::exp_float::launch_unchecked::<f32>(
+            client,
+            count.clone(),
+            dim,
+            arg(&out_h, len),
+            arg(&input_h, len),
+        );
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<f32>(client, &out_h, len);
+    checked(
+        samples(len, 65_537)
+            .into_iter()
+            .all(|index| close_f32(got[index], input[index].exp())),
+        case,
+    );
+    measure(backend.runtime(), &mut run);
+    emit_meta(case, &Meta::simple("exp_float"), "ok", "");
+}
+
+fn run_mul_c64(case: &str, len: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let mut rng = Rng::new(0x1111_2222);
+    let lhs: Vec<Complex64> = (0..len).map(|_| rng.c64()).collect();
+    let rhs: Vec<Complex64> = (0..len).map(|_| rng.c64()).collect();
+    let lhs_h = upload(client, &lhs);
+    let rhs_h = upload(client, &rhs);
+    let out_h = client.empty(len * std::mem::size_of::<Complex64>());
+    let (count, dim) = flat(len);
+    let mut run = || unsafe {
+        kernels::elementwise::mul_complex::launch_unchecked::<Complex64>(
+            client,
+            count.clone(),
+            dim,
+            arg(&out_h, len),
+            arg(&lhs_h, len),
+            arg(&rhs_h, len),
+        );
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<Complex64>(client, &out_h, len);
+    checked(
+        samples(len, 65_537).into_iter().all(|index| {
+            let expected = lhs[index] * rhs[index];
+            close_f64(got[index].re, expected.re) && close_f64(got[index].im, expected.im)
+        }),
+        case,
+    );
+    measure(backend.runtime(), &mut run);
+    emit_meta(case, &Meta::simple("mul_complex"), "ok", "");
+}
+
+fn run_div_c64(case: &str, len: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let mut rng = Rng::new(0x3333_4444);
+    let lhs: Vec<Complex64> = (0..len).map(|_| rng.c64()).collect();
+    let rhs: Vec<Complex64> = (0..len)
+        .map(|_| rng.c64() + Complex64::new(2.0, 1.0))
+        .collect();
+    let lhs_h = upload(client, &lhs);
+    let rhs_h = upload(client, &rhs);
+    let out_h = client.empty(len * std::mem::size_of::<Complex64>());
+    let part_len = len * 2;
+    let (count, dim) = flat(len);
+    let mut run = || unsafe {
+        kernels::elementwise::div_complex_parts::launch_unchecked::<f64>(
+            client,
+            count.clone(),
+            dim,
+            arg(&out_h, part_len),
+            arg(&lhs_h, part_len),
+            arg(&rhs_h, part_len),
+        );
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<Complex64>(client, &out_h, len);
+    checked(
+        samples(len, 65_537).into_iter().all(|index| {
+            let expected = lhs[index] / rhs[index];
+            close_f64(got[index].re, expected.re) && close_f64(got[index].im, expected.im)
+        }),
+        case,
+    );
+    measure(backend.runtime(), &mut run);
+    emit_meta(case, &Meta::simple("div_complex_parts"), "ok", "");
+}
+
+// ---------------------------------------------------------------------------
+// Fusion
+// ---------------------------------------------------------------------------
+
+fn fusion_chain_reference(x: f64) -> f64 {
+    let sum = x + x;
+    (sum * sum).exp().tanh()
+}
+
+fn fusion_plan_chain() -> ElementwiseFusionPlan {
+    ElementwiseFusionPlan::new(
+        DType::F32,
+        1,
+        vec![4],
+        vec![
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Add, vec![0, 0]),
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Multiply, vec![1, 1]),
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Exp, vec![2]),
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Tanh, vec![3]),
+        ],
+    )
+}
+
+fn run_fused_chain_f32(case: &str, len: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let plan = fusion_plan_chain();
+    let mut rng = Rng::new(0x5555_6666);
+    let host: Vec<f32> = (0..len).map(|_| rng.f32()).collect();
+    let host_tensor =
+        Tensor::from_typed::<f32>(TypedTensor::from_vec_col_major(vec![len], host.clone()).unwrap());
+    let input = crate::cuda::upload_tensor(backend.runtime(), &host_tensor).unwrap();
+
+    let mut run = || {
+        let outputs =
+            fusion::execute_elementwise_fusion(&backend, &[&input], &plan)
+                .expect("fused launch")
+                .expect("eligible fusion plan");
+        assert_eq!(outputs.len(), 1);
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let outputs = fusion::execute_elementwise_fusion(&backend, &[&input], &plan)
+        .unwrap()
+        .expect("eligible fusion plan");
+    backend.runtime().synchronize().unwrap();
+    let downloaded = crate::cuda::download_tensor(backend.runtime(), &outputs[0]).unwrap();
+    let values = downloaded.as_typed::<f32>().unwrap().as_slice().unwrap();
+    checked(
+        samples(len, 65_537)
+            .into_iter()
+            .all(|index| close_f32(values[index], fusion_chain_reference(host[index] as f64) as f32)),
+        case,
+    );
+    measure(backend.runtime(), &mut run);
+    emit_meta(
+        case,
+        &Meta {
+            kernels: "tenferro_fused_elementwise",
+            launches: 1,
+            scratch_bytes: 0,
+            // The baseline launcher allocates each output inside the call.
+            allocations: 1,
+            zero_fills: 0,
+        },
+        "ok",
+        "",
+    );
+}
+
+fn run_fused_add_mul_c64(case: &str, len: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    // (x + x) * x * (x + x): three intermediates, one output, one launch.
+    let plan = ElementwiseFusionPlan::new(
+        DType::C64,
+        1,
+        vec![3],
+        vec![
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Add, vec![0, 0]),
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Multiply, vec![1, 0]),
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Multiply, vec![2, 1]),
+        ],
+    );
+    let mut rng = Rng::new(0x7777_8888);
+    let host: Vec<Complex64> = (0..len).map(|_| rng.c64()).collect();
+    let host_tensor = Tensor::from_typed::<tenferro_tensor::Complex64>(
+        TypedTensor::from_vec_col_major(vec![len], host.clone()).unwrap(),
+    );
+    let input = crate::cuda::upload_tensor(backend.runtime(), &host_tensor).unwrap();
+    let mut run = || {
+        let outputs =
+            fusion::execute_elementwise_fusion(&backend, &[&input], &plan)
+                .expect("fused launch")
+                .expect("eligible fusion plan");
+        assert_eq!(outputs.len(), 1);
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let outputs = fusion::execute_elementwise_fusion(&backend, &[&input], &plan)
+        .unwrap()
+        .expect("eligible fusion plan");
+    backend.runtime().synchronize().unwrap();
+    let downloaded = crate::cuda::download_tensor(backend.runtime(), &outputs[0]).unwrap();
+    let values = downloaded
+        .as_typed::<tenferro_tensor::Complex64>()
+        .unwrap()
+        .as_slice()
+        .unwrap();
+    checked(
+        samples(len, 65_537).into_iter().all(|index| {
+            let x = host[index];
+            let expected = (x + x) * x * (x + x);
+            close_f64(values[index].re, expected.re) && close_f64(values[index].im, expected.im)
+        }),
+        case,
+    );
+    measure(backend.runtime(), &mut run);
+    emit_meta(
+        case,
+        &Meta {
+            kernels: "tenferro_fused_elementwise",
+            launches: 1,
+            scratch_bytes: 0,
+            allocations: 1,
+            zero_fills: 0,
+        },
+        "ok",
+        "",
+    );
+}
+
+fn run_fused_two_live_outs_f32(case: &str, len: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let plan = ElementwiseFusionPlan::new(
+        DType::F32,
+        1,
+        vec![2, 3],
+        vec![
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Add, vec![0, 0]),
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Exp, vec![1]),
+            ElementwiseFusionInst::new(ElementwiseFusionOp::Tanh, vec![1]),
+        ],
+    );
+    let mut rng = Rng::new(0x9999_AAAA);
+    let host: Vec<f32> = (0..len).map(|_| rng.f32()).collect();
+    let host_tensor =
+        Tensor::from_typed::<f32>(TypedTensor::from_vec_col_major(vec![len], host.clone()).unwrap());
+    let input = crate::cuda::upload_tensor(backend.runtime(), &host_tensor).unwrap();
+    let mut run = || {
+        let outputs =
+            fusion::execute_elementwise_fusion(&backend, &[&input], &plan)
+                .expect("fused launch")
+                .expect("eligible fusion plan");
+        assert_eq!(outputs.len(), 2);
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let outputs = fusion::execute_elementwise_fusion(&backend, &[&input], &plan)
+        .unwrap()
+        .expect("eligible fusion plan");
+    backend.runtime().synchronize().unwrap();
+    let first_tensor = crate::cuda::download_tensor(backend.runtime(), &outputs[0]).unwrap();
+    let second_tensor = crate::cuda::download_tensor(backend.runtime(), &outputs[1]).unwrap();
+    let first = first_tensor.as_typed::<f32>().unwrap().as_slice().unwrap();
+    let second = second_tensor.as_typed::<f32>().unwrap().as_slice().unwrap();
+    checked(
+        samples(len, 65_537).into_iter().all(|index| {
+            let doubled = host[index] + host[index];
+            close_f32(first[index], doubled.exp())
+                && close_f32(second[index], (doubled as f64).tanh() as f32)
+        }),
+        case,
+    );
+    measure(backend.runtime(), &mut run);
+    emit_meta(
+        case,
+        &Meta {
+            kernels: "tenferro_fused_elementwise",
+            launches: 1,
+            scratch_bytes: 0,
+            allocations: 2,
+            zero_fills: 0,
+        },
+        "ok",
+        "",
+    );
+}
