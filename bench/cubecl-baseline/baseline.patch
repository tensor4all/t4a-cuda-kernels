+    let src = upload(client, &values);
+    let meta = plan_reduce(client, &in_shape, 0, &src, 8);
+    let out_len = meta.out_shape[0] * meta.out_shape[1];
+    let dst = client.empty(out_len * 8);
+    let partials = meta
+        .partials_shape
+        .as_ref()
+        .map(|shape| client.empty(shape.iter().product::<usize>() * 8));
+    let mut run = || {
+        let (out, input, partials_binding) = reduce_bindings(&meta, &dst, &src, partials.as_ref());
+        kernels::reduce::launch_sum_float::<f64>(
+            client,
+            input,
+            out,
+            0,
+            kernels::reduce::ReduceStrategy::Auto,
+            partials_binding,
+        )
+        .expect("reduce launch");
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<f64>(client, &dst, out_len);
+    let mut ok = true;
+    for out_flat in 0..out_len {
+        let mut sum = 0.0f64;
+        let mut abs_sum = 0.0f64;
+        for index in 0..side {
+            let value = values[index + out_flat * side];
+            sum += value;
+            abs_sum += value.abs();
+        }
+        if !close_sum(got[out_flat], sum, abs_sum) {
+            ok = false;
+        }
+    }
+    checked(ok, case);
+    measure(backend.runtime(), &mut run);
+    let launches = meta.launches;
+    let scratch = partials_bytes(&meta, 8);
+    emit_meta(
+        case,
+        &Meta {
+            kernels: "reduce_sum_float|reduce_sum_float_plane",
+            launches,
+            scratch_bytes: scratch,
+            allocations: 0,
+            zero_fills: 0,
+        },
+        "ok",
+        &format!("reduce_len={side} output_len={out_len}"),
+    );
+}
+
+fn run_reduce_sum_c64(case: &str, side: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let in_shape = [side, side];
+    let in_len = side * side;
+    let mut rng = Rng::new(0x0E0E_0E0E);
+    let values: Vec<Complex64> = (0..in_len).map(|_| rng.c64()).collect();
+    let src = upload(client, &values);
+    let meta = plan_reduce(client, &in_shape, 0, &src, 8);
+    let out_len = meta.out_shape[0] * meta.out_shape[1];
+    let dst = client.empty(out_len * std::mem::size_of::<Complex64>());
+    let partials = meta.partials_shape.as_ref().map(|shape| {
+        client.empty(shape.iter().product::<usize>() * std::mem::size_of::<Complex64>())
+    });
+    let mut run = || {
+        let (out, input, partials_binding) = reduce_bindings(&meta, &dst, &src, partials.as_ref());
+        kernels::reduce::launch_sum_complex::<Complex64>(
+            client,
+            input,
+            out,
+            0,
+            kernels::reduce::ReduceStrategy::Auto,
+            partials_binding,
+        )
+        .expect("reduce launch");
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<Complex64>(client, &dst, out_len);
+    let mut ok = true;
+    for out_flat in 0..out_len {
+        let mut sum = Complex64::new(0.0, 0.0);
+        let mut abs_sum = 0.0f64;
+        for index in 0..side {
+            let value = values[index + out_flat * side];
+            sum += value;
+            abs_sum += value.norm();
+        }
+        if !close_sum(got[out_flat].re, sum.re, abs_sum) || !close_sum(got[out_flat].im, sum.im, abs_sum)
+        {
+            ok = false;
+        }
+    }
+    checked(ok, case);
+    measure(backend.runtime(), &mut run);
+    let launches = meta.launches;
+    let scratch = partials_bytes(&meta, 16);
+    emit_meta(
+        case,
+        &Meta {
+            kernels: "reduce_sum_complex|reduce_sum_complex_plane",
+            launches,
+            scratch_bytes: scratch,
+            allocations: 0,
+            zero_fills: 0,
+        },
+        "ok",
+        &format!("reduce_len={side} output_len={out_len}"),
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Gather and additive scatter
+// ---------------------------------------------------------------------------
+
+fn run_gather(case: &str, rows: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let cols = 256usize;
+    let requested = 1024usize;
+    let mut rng = Rng::new(0xFACE_0000 + rows as u64);
+    let table: Vec<f32> = (0..rows * cols).map(|_| rng.f32()).collect();
+    let indices: Vec<i32> = (0..requested)
+        .map(|_| (rng.next_u64() % rows as u64) as i32)
+        .collect();
+    let operand = upload(client, &table);
+    let index_buf = upload(client, &indices);
+    let out_len = requested * cols;
+    let dst = client.empty(out_len * 4);
+    let operand_shape = [rows, cols];
+    let index_shape = [requested, 1usize];
+    let out_shape = [requested, cols];
+    let (count, dim) = flat(out_len);
+    let mut run = || unsafe {
+        kernels::indexing::gather_kernel::launch_unchecked::<f32, i32>(
+            client,
+            count.clone(),
+            dim,
+            binding(&dst, &out_shape, &compact_strides(&out_shape)).into_tensor_arg(),
+            binding(&operand, &operand_shape, &compact_strides(&operand_shape)).into_tensor_arg(),
+            binding(&index_buf, &index_shape, &compact_strides(&index_shape)).into_tensor_arg(),
+            comptime_sequence(&[1usize]),
+            comptime_sequence(&[1usize]),
+            comptime_sequence(&[0usize]),
+            runtime_sequence(&[1usize, cols]),
+            1usize,
+            2usize,
+            2usize,
+            2usize,
+        );
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<f32>(client, &dst, out_len);
+    let mut ok = true;
+    for row in 0..requested {
+        for col in 0..cols {
+            let expected = table[indices[row] as usize + col * rows];
+            if !close_f32(got[row + col * requested], expected) {
+                ok = false;
+            }
+        }
+    }
+    checked(ok, case);
+    measure(backend.runtime(), &mut run);
+    emit_meta(case, &Meta::simple("gather_kernel"), "ok", "");
+}
+
+fn run_scatter_add(case: &str, complex: bool) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let slots = 16usize;
+    let updates = 1_000_000usize;
+    let indices: Vec<i32> = (0..updates)
+        .map(|index| ((index * 7 + index / 3) % slots) as i32)
+        .collect();
+    let mut rng = Rng::new(0xF00D_0000 + u64::from(complex));
+    let operand_shape = [slots];
+    let index_shape = [updates, 1usize];
+    let update_shape = [updates];
+    let elem = if complex { 16 } else { 4 };
+    let dst = client.empty(slots * elem);
+    let (copy_count, copy_dim) = flat(slots);
+    let (count, dim) = flat(updates);
+    // Values are generated before the measured region; the two sides differ
+    // only in the element type and the atomic kernel.
+    let (operand, update_values): (Vec<u8>, Vec<u8>) = if complex {
+        let operand: Vec<Complex64> = (0..slots)
+            .map(|index| Complex64::new(index as f64, -(index as f64)))
+            .collect();
+        let updates: Vec<Complex64> = (0..updates).map(|_| rng.c64()).collect();
+        (bytes_of(&operand).to_vec(), bytes_of(&updates).to_vec())
+    } else {
+        let operand: Vec<f32> = (0..slots).map(|index| index as f32).collect();
+        let updates: Vec<f32> = (0..updates).map(|_| rng.f32()).collect();
+        (bytes_of(&operand).to_vec(), bytes_of(&updates).to_vec())
+    };
+    let operand_h = client.create_from_slice(&operand);
+    let index_h = upload(client, &indices);
+    let update_h = client.create_from_slice(&update_values);
+    let index_binding = binding(&index_h, &index_shape, &compact_strides(&index_shape));
+    let operand_tensor = binding(&operand_h, &operand_shape, &[1]);
+    let update_tensor = binding(&update_h, &update_shape, &[1]);
+
+    let mut run = || unsafe {
+        if complex {
+            kernels::indexing::scatter_copy_kernel::launch_unchecked::<Complex64>(
+                client,
+                copy_count.clone(),
+                copy_dim,
+                binding(&dst, &operand_shape, &[1]).into_tensor_arg(),
+                operand_tensor.clone().into_tensor_arg(),
+            );
+            kernels::indexing::scatter_complex_kernel::launch_unchecked::<Complex64, f64, i32>(
+                client,
+                count.clone(),
+                dim,
+                arg(&dst, slots * 2),
+                operand_tensor.clone().into_tensor_arg(),
+                index_binding.clone().into_tensor_arg(),
+                update_tensor.clone().into_tensor_arg(),
+                arg(&update_h, updates * 2),
+                comptime_sequence::<usize>(&[]),
+                comptime_sequence::<usize>(&[]),
+                comptime_sequence(&[0usize]),
+                1usize,
+                1usize,
+                1usize,
+                2usize,
+            );
+        } else {
+            kernels::indexing::scatter_copy_kernel::launch_unchecked::<f32>(
+                client,
+                copy_count.clone(),
+                copy_dim,
+                binding(&dst, &operand_shape, &[1]).into_tensor_arg(),
+                operand_tensor.clone().into_tensor_arg(),
+            );
+            kernels::indexing::scatter_float_kernel::launch_unchecked::<f32, i32>(
+                client,
+                count.clone(),
+                dim,
+                arg(&dst, slots),
+                operand_tensor.clone().into_tensor_arg(),
+                index_binding.clone().into_tensor_arg(),
+                update_tensor.clone().into_tensor_arg(),
+                comptime_sequence::<usize>(&[]),
+                comptime_sequence::<usize>(&[]),
+                comptime_sequence(&[0usize]),
+                1usize,
+                1usize,
+                1usize,
+                2usize,
+            );
+        }
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let mut ok = true;
+    if complex {
+        let got = read::<Complex64>(client, &dst, slots);
+        let operand_values: Vec<Complex64> = typed(&operand);
+        let update_elements: Vec<Complex64> = typed(&update_values);
+        let mut expected = operand_values;
+        for index in 0..updates {
+            expected[indices[index] as usize] += update_elements[index];
+        }
+        for slot in 0..slots {
+            if !close_f64(got[slot].re, expected[slot].re)
+                || !close_f64(got[slot].im, expected[slot].im)
+            {
+                ok = false;
+            }
+        }
+    } else {
+        let got = read::<f32>(client, &dst, slots);
+        let operand_values: Vec<f32> = typed(&operand);
+        let update_elements: Vec<f32> = typed(&update_values);
+        let mut expected: Vec<f64> = operand_values.iter().map(|&value| value as f64).collect();
+        let mut magnitude: Vec<f64> = operand_values.iter().map(|&value| (value as f64).abs()).collect();
+        for index in 0..updates {
+            let slot = indices[index] as usize;
+            expected[slot] += update_elements[index] as f64;
+            magnitude[slot] += (update_elements[index] as f64).abs();
+        }
+        // The f32 atomic accumulation rounds at the running-sum magnitude, so
+        // the tolerance is relative to the accumulated magnitude, not the
+        // final value.
+        for slot in 0..slots {
+            if !close_sum(got[slot] as f64, expected[slot], magnitude[slot]) {
+                ok = false;
+            }
+        }
+    }
+    checked(ok, case);
+    measure(backend.runtime(), &mut run);
+    emit_meta(
+        case,
+        &Meta {
+            kernels: if complex {
+                "scatter_copy_kernel|scatter_complex_kernel"
+            } else {
+                "scatter_copy_kernel|scatter_float_kernel"
+            },
+            launches: 2,
+            scratch_bytes: 0,
+            allocations: 0,
+            zero_fills: 0,
+        },
+        "ok",
+        "",
+    );
+}
