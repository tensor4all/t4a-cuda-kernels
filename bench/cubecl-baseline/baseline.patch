+/// Static window slice of a 4096² F32 source; one `(start, size, step)` set per
+/// case. The baseline takes the steps as compile-time configuration.
+fn run_slice_f32(case: &str, set: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let side = 4096usize;
+    let (starts, sizes, steps): ([usize; 2], [usize; 2], [usize; 2]) = match set {
+        1 => ([3, 5], [1_000, 2_000], [1, 1]),
+        2 => ([0, 0], [2_048, 2_048], [2, 1]),
+        3 => ([17, 4_095], [2_048, 1], [1, 1]),
+        _ => ([1, 2], [4_095, 4_093], [1, 1]),
+    };
+    let backend = backend();
+    let client = client(&backend);
+    let len = side * side;
+    let out_len = sizes[0] * sizes[1];
+    let mut rng = Rng::new(0x9999 + set as u64);
+    let values: Vec<f32> = (0..len).map(|_| rng.f32()).collect();
+    let src = upload(client, &values);
+    let dst = client.empty(out_len * 4);
+    let (count, dim) = flat(out_len);
+    let mut run = || unsafe {
+        kernels::indexing::slice_kernel::launch_unchecked::<f32>(
+            client,
+            count.clone(),
+            dim,
+            binding(&dst, &sizes, &[1, sizes[0]]).into_tensor_arg(),
+            binding(&src, &[side, side], &[1, side]).into_tensor_arg(),
+            runtime_sequence(&starts),
+            comptime_sequence(&steps),
+        );
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<f32>(client, &dst, out_len);
+    let mut ok = true;
+    for i in 0..sizes[0] {
+        for j in 0..sizes[1] {
+            let expected = values[starts[0] + i * steps[0] + (starts[1] + j * steps[1]) * side];
+            if !close_f32(got[i + j * sizes[0]], expected) {
+                ok = false;
+            }
+        }
+    }
+    checked(ok, case);
+    measure(backend.runtime(), &mut run);
+    emit_meta(case, &Meta::simple("slice_kernel"), "ok", "");
+}
+
+/// Padding of a 4096² F32 source; one `(low, high, interior)` set per case.
+/// The baseline's pad kernel leaves out-of-source positions untouched, so only
+/// in-source positions are checked on this side.
+fn run_pad_f32(case: &str, set: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let side = 4096usize;
+    let (low, high, interior): ([i64; 2], [i64; 2], [i64; 2]) = match set {
+        1 => ([1, 2], [3, 4], [0, 0]),
+        2 => ([0, 0], [0, 1], [1, 0]),
+        3 => ([5, 7], [0, 0], [0, 2]),
+        _ => ([2, 2], [2, 2], [1, 1]),
+    };
+    let out_extent = |axis: usize| -> usize {
+        ((side as i64 - 1) * (interior[axis] + 1) + 1 + low[axis] + high[axis]) as usize
+    };
+    let out_shape = [out_extent(0), out_extent(1)];
+    let out_len = out_shape[0] * out_shape[1];
+    let backend = backend();
+    let client = client(&backend);
+    let len = side * side;
+    let mut rng = Rng::new(0xAAAA + set as u64);
+    let values: Vec<f32> = (0..len).map(|_| rng.f32()).collect();
+    let src = upload(client, &values);
+    let dst = client.empty(out_len * 4);
+    let (count, dim) = flat(out_len);
+    let mut run = || unsafe {
+        kernels::indexing::pad_kernel::launch_unchecked::<f32>(
+            client,
+            count.clone(),
+            dim,
+            binding(&dst, &out_shape, &[1, out_shape[0]]).into_tensor_arg(),
+            binding(&src, &[side, side], &[1, side]).into_tensor_arg(),
+            runtime_sequence(&low),
+            runtime_sequence(&interior),
+            2usize,
+        );
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<f32>(client, &dst, out_len);
+    let mut ok = true;
+    for i in 0..out_shape[0] {
+        for j in 0..out_shape[1] {
+            let i_shift = i as i64 - low[0];
+            let j_shift = j as i64 - low[1];
+            let spacing_i = interior[0] + 1;
+            let spacing_j = interior[1] + 1;
+            if i_shift < 0 || j_shift < 0 {
+                continue;
+            }
+            if i_shift % spacing_i != 0 || j_shift % spacing_j != 0 {
+                continue;
+            }
+            let source_i = (i_shift / spacing_i) as usize;
+            let source_j = (j_shift / spacing_j) as usize;
+            if source_i >= side || source_j >= side {
+                continue;
+            }
+            let expected = values[source_i + source_j * side];
+            if !close_f32(got[i + j * out_shape[0]], expected) {
+                ok = false;
+            }
+        }
+    }
+    checked(ok, case);
+    measure(backend.runtime(), &mut run);
+    emit_meta(case, &Meta::simple("pad_kernel"), "ok", "");
+}
+
+// ---------------------------------------------------------------------------
+// Reduction
+// ---------------------------------------------------------------------------
+
+/// Everything one reduction case needs to submit its matched sequence.
+struct ReduceCase {
+    out_shape: Vec<usize>,
+    in_shape: Vec<usize>,
+    partials_shape: Option<Vec<usize>>,
+    launches: usize,
+}
+
+fn reduce_case(
+    client: &cubecl::client::Client,
+    in_shape: &[usize],
+    axis: usize,
+    dst: &Handle,
+    src: &Handle,
+) -> ReduceCase {
+    let mut out_shape = in_shape.to_vec();
+    out_shape[axis] = 1;
+    let in_strides = compact_strides(in_shape);
+    let out_strides = compact_strides(&out_shape);
+    let plan = kernels::reduce::plan(
+        client,
+        &binding(src, in_shape, &in_strides),
+        &binding(dst, &out_shape, &out_strides),
+        axis,
+        kernels::reduce::ReduceStrategy::Auto,
+    )
+    .expect("reduce plan");
+    let partials_shape = kernels::reduce::partials_shape(&plan, &out_shape, axis);
+    ReduceCase {
+        launches: if partials_shape.is_some() { 2 } else { 1 },
+        partials_shape,
+        out_shape,
+        in_shape: in_shape.to_vec(),
+    }
+}
+
+/// Plan the case with a throwaway one-element destination probe, then allocate
+/// the real destination at the planned size.
+fn plan_reduce(
+    client: &cubecl::client::Client,
+    in_shape: &[usize],
+    axis: usize,
+    src: &Handle,
+    probe_bytes: usize,
+) -> ReduceCase {
+    let probe = client.empty(probe_bytes);
+    let case = reduce_case(client, in_shape, axis, &probe, src);
+    drop(probe);
+    case
+}
+
+fn reduce_bindings(
+    case: &ReduceCase,
+    dst: &Handle,
+    src: &Handle,
+    partials: Option<&Handle>,
+) -> (TensorBinding, TensorBinding, Option<TensorBinding>) {
+    let out = binding(dst, &case.out_shape, &compact_strides(&case.out_shape));
+    let input = binding(src, &case.in_shape, &compact_strides(&case.in_shape));
+    let partials = partials.map(|handle| {
+        let shape = case.partials_shape.as_ref().unwrap();
+        binding(handle, shape, &compact_strides(shape))
+    });
+    (out, input, partials)
+}
+
+fn partials_bytes(case: &ReduceCase, elem_size: usize) -> usize {
+    case.partials_shape
+        .as_ref()
+        .map(|shape| shape.iter().product::<usize>() * elem_size)
+        .unwrap_or(0)
+}
+
+fn run_reduce_sum_f32(case: &str, in_shape: [usize; 2], axis: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let in_len = in_shape[0] * in_shape[1];
+    let mut rng = Rng::new(0x1357_9BDF ^ in_shape[0] as u64);
+    let values: Vec<f32> = (0..in_len).map(|_| rng.f32()).collect();
+    let src = upload(client, &values);
+    let meta = plan_reduce(client, &in_shape, axis, &src, 4);
+    let out_len = meta.out_shape[0] * meta.out_shape[1];
+    let dst = client.empty(out_len * 4);
+    let partials = meta
+        .partials_shape
+        .as_ref()
+        .map(|shape| client.empty(shape.iter().product::<usize>() * 4));
+    let mut run = || {
+        let (out, input, partials_binding) = reduce_bindings(&meta, &dst, &src, partials.as_ref());
+        kernels::reduce::launch_sum_float::<f32>(
+            client,
+            input,
+            out,
+            axis,
+            kernels::reduce::ReduceStrategy::Auto,
+            partials_binding,
+        )
+        .expect("reduce launch");
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<f32>(client, &dst, out_len);
+    let mut ok = true;
+    for out_flat in 0..out_len {
+        let mut sum = 0.0f64;
+        let mut abs_sum = 0.0f64;
+        for index in 0..in_shape[axis] {
+            let source = if axis == 0 {
+                index + (out_flat / meta.out_shape[0]) * in_shape[0]
+            } else {
+                (out_flat % meta.out_shape[0]) + index * in_shape[0]
+            };
+            let value = values[source] as f64;
+            sum += value;
+            abs_sum += value.abs();
+        }
+        if !close_sum(got[out_flat] as f64, sum, abs_sum) {
+            ok = false;
+        }
+    }
+    checked(ok, case);
+    measure(backend.runtime(), &mut run);
+    let kernels_used = if meta.launches == 2 {
+        "reduce_sum_float_chunked|reduce_sum_float|reduce_sum_float_plane"
+    } else {
+        "reduce_sum_float|reduce_sum_float_plane"
+    };
+    let launches = meta.launches;
+    let scratch = partials_bytes(&meta, 4);
+    emit_meta(
+        case,
+        &Meta {
+            kernels: kernels_used,
+            launches,
+            scratch_bytes: scratch,
+            allocations: 0,
+            zero_fills: 0,
+        },
+        "ok",
+        &format!("reduce_len={} output_len={out_len}", in_shape[axis]),
+    );
+}
+
+fn run_reduce_max_i32(case: &str, side: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let in_shape = [side, side];
+    let in_len = side * side;
+    let mut rng = Rng::new(0x2468_ACE0);
+    let values: Vec<i32> = (0..in_len).map(|_| rng.i32()).collect();
+    let src = upload(client, &values);
+    let meta = plan_reduce(client, &in_shape, 0, &src, 8);
+    let out_len = meta.out_shape[0] * meta.out_shape[1];
+    let dst = client.empty(out_len * 4);
+    let partials = meta
+        .partials_shape
+        .as_ref()
+        .map(|shape| client.empty(shape.iter().product::<usize>() * 4));
+    let mut run = || {
+        let (out, input, partials_binding) = reduce_bindings(&meta, &dst, &src, partials.as_ref());
+        kernels::reduce::launch_max_int::<i32>(
+            client,
+            input,
+            out,
+            0,
+            kernels::reduce::ReduceStrategy::Auto,
+            partials_binding,
+        )
+        .expect("reduce launch");
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<i32>(client, &dst, out_len);
+    let mut ok = true;
+    for out_flat in 0..out_len {
+        let mut best = i32::MIN;
+        for index in 0..side {
+            best = best.max(values[index + out_flat * side]);
+        }
+        if got[out_flat] != best {
+            ok = false;
+        }
+    }
+    checked(ok, case);
+    measure(backend.runtime(), &mut run);
+    let launches = meta.launches;
+    let scratch = partials_bytes(&meta, 4);
+    emit_meta(
+        case,
+        &Meta {
+            kernels: "reduce_max_int|reduce_max_int_plane",
+            launches,
+            scratch_bytes: scratch,
+            allocations: 0,
+            zero_fills: 0,
+        },
+        "ok",
+        &format!("reduce_len={side} output_len={out_len}"),
+    );
+}
