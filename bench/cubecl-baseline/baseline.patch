+//! Paired A100 benchmark harness for the linalg auxiliary kernels and the RRQR
+//! primitive sequence (slice F, unit U6).
+//!
+//! Added by `bench/cubecl-baseline/baseline.patch` of `t4a-cuda-kernels`; it is
+//! not part of the shipped crate. It lives inside the RRQR host-orchestration
+//! module so it can call the private per-step launchers and mirror the host
+//! loop one launch at a time.
+//!
+//! Protocol: 10 warm-ups outside the capture range, `cuProfilerStart`, 100
+//! timed iterations, one barrier at the observation boundary,
+//! `cuProfilerStop`. `T4A_BENCH_CASES` selects the cases (comma separated, or
+//! `all`).
+
+use std::ffi::c_void;
+
+use cubecl::prelude::{CubeCount, CubeDim, Scalar, TensorBinding};
+use tenferro_gpu::cuda::{
+    download_tensor, upload_tensor, with_cuda_exec_session, CudaBackend, CudaExecSession,
+    CudaRuntime,
+};
+use tenferro_tensor::backend::BackendSessionHost;
+use num_complex::Complex64;
+use tenferro_tensor::{Tensor, TypedTensor};
+
+use super::*;
+
+const WARMUPS: usize = 10;
+const ITERS: usize = 100;
+
+// ---------------------------------------------------------------------------
+// CUDA profiler range (cuProfilerStart / cuProfilerStop are not bound by
+// cudarc; they are resolved from the driver library at run time).
+// ---------------------------------------------------------------------------
+
+struct Profiler {
+    start: unsafe extern "C" fn(u32) -> i32,
+    stop: unsafe extern "C" fn(u32) -> i32,
+}
+
+unsafe extern "C" {
+    fn dlopen(filename: *const i8, flag: i32) -> *mut c_void;
+    fn dlsym(handle: *mut c_void, symbol: *const i8) -> *mut c_void;
+}
+
+fn profiler() -> &'static Profiler {
+    static PROFILER: std::sync::OnceLock<Profiler> = std::sync::OnceLock::new();
+    PROFILER.get_or_init(|| unsafe {
+        let handle = dlopen(c"libcuda.so.1".as_ptr(), 1);
+        assert!(!handle.is_null(), "libcuda.so.1 not loadable");
+        let resolve = |symbol: &std::ffi::CStr| -> *mut c_void {
+            let pointer = dlsym(handle, symbol.as_ptr());
+            assert!(!pointer.is_null(), "driver profiler symbol missing");
+            pointer
+        };
+        Profiler {
+            start: std::mem::transmute::<*mut c_void, unsafe extern "C" fn(u32) -> i32>(resolve(
+                c"cuProfilerStart",
+            )),
+            stop: std::mem::transmute::<*mut c_void, unsafe extern "C" fn(u32) -> i32>(resolve(
+                c"cuProfilerStop",
+            )),
+        }
+    })
+}
+
+fn profile_start() {
+    // SAFETY: the driver entry point takes the CUDA context (0 = current).
+    let status = unsafe { (profiler().start)(0) };
+    assert_eq!(status, 0, "cuProfilerStart failed with {status}");
+}
+
+fn profile_stop() {
+    let status = unsafe { (profiler().stop)(0) };
+    assert_eq!(status, 0, "cuProfilerStop failed with {status}");
+}
+
+// ---------------------------------------------------------------------------
+// Bookkeeping
+// ---------------------------------------------------------------------------
+
+fn wanted(case: &str) -> bool {
+    match std::env::var("T4A_BENCH_CASES") {
+        Err(_) => true,
+        Ok(value) => value
+            .split(',')
+            .map(str::trim)
+            .any(|entry| entry == case || entry == "all"),
+    }
+}
+
+fn emit_meta(case: &str, kernels: &str, launches: usize, scratch_bytes: usize, check: &str) {
+    println!(
+        "BENCH_META case={case} kernels={kernels} launches_per_iter={launches} \
+         scratch_bytes={scratch_bytes} host_waits_per_iter=0 transfer_bytes_per_iter=0 \
+         device_allocations_per_iter=0 zero_fills_per_iter=0 boundary_barriers=1 check={check}"
+    );
+}
+
+/// The frozen protocol around a prepared submission closure.
+fn measure(runtime: &CudaRuntime, run: &mut impl FnMut()) {
+    for _ in 0..WARMUPS {
+        run();
+    }
+    runtime.synchronize().expect("warm-up synchronize");
+    profile_start();
+    for _ in 0..ITERS {
+        run();
+    }
+    runtime.synchronize().expect("measured synchronize");
+    profile_stop();
+}
+
+fn backend() -> CudaBackend {
+    let devices = tenferro_gpu::cuda::cuda_devices().expect("CUDA device discovery");
+    let device = devices.first().expect("at least one CUDA device");
+    CudaBackend::new(device.id()).expect("CUDA backend")
+}
+
+fn with_cuda_exec<R>(
+    backend: &mut CudaBackend,
+    f: impl FnOnce(&mut CudaExecSession<'_>) -> R + Send,
+) -> R {
+    backend
+        .with_backend_session(|session| with_cuda_exec_session(session, f).expect("CUDA session"))
+        .unwrap()
+}
+
+struct Rng(u64);
+
+impl Rng {
+    fn new(seed: u64) -> Rng {
+        Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1)
+    }
+
+    fn next_u64(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x << 13;
+        x ^= x >> 7;
+        x ^= x << 17;
+        self.0 = x;
+        x
+    }
+
+    fn f64(&mut self) -> f64 {
+        (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64 - 0.5
+    }
+
+    fn c64(&mut self) -> num_complex::Complex64 {
+        num_complex::Complex64::new(self.f64() * 2.0, self.f64() * 2.0)
+    }
+}
+
+/// A host tensor placed on the device before the measured region.
+fn placed<T: TensorScalar>(backend: &CudaBackend, shape: Vec<usize>, data: Vec<T>) -> Tensor {
+    let host = TypedTensor::<T>::from_vec_col_major(shape, data).expect("host tensor");
+    upload_tensor(backend.runtime(), &Tensor::from_typed::<T>(host)).expect("upload")
+}
+
+fn typed<'a, T: TensorScalar>(tensor: &'a Tensor) -> &'a TypedTensor<T> {
+    tensor.as_typed::<T>().expect("typed device tensor")
+}
+
+fn downloaded<T: TensorScalar>(runtime: &CudaRuntime, tensor: &Tensor) -> Vec<T> {
+    let host = download_tensor(runtime, tensor).expect("download");
+    host.as_typed::<T>()
+        .expect("typed host tensor")
+        .as_slice()
+        .expect("contiguous host tensor")
+        .to_vec()
+}
+
+/// Scalar arithmetic and magnitude for the host-side reference checks.
+trait BenchScalar: Copy {
+    fn zero() -> Self;
+    fn sum(self, other: Self) -> Self;
+    fn difference(self, other: Self) -> Self;
+    fn product(self, other: Self) -> Self;
+    fn magnitude(self) -> f64;
+    fn conjugate(self) -> Self;
+}
+
+impl BenchScalar for f64 {
+    fn zero() -> Self {
+        0.0
+    }
+    fn sum(self, other: Self) -> Self {
+        self + other
+    }
+    fn difference(self, other: Self) -> Self {
+        self - other
+    }
+    fn product(self, other: Self) -> Self {
+        self * other
+    }
+    fn magnitude(self) -> f64 {
+        self.abs()
+    }
+    fn conjugate(self) -> Self {
+        self
+    }
+}
+
+impl BenchScalar for num_complex::Complex64 {
+    fn zero() -> Self {
+        num_complex::Complex64::new(0.0, 0.0)
+    }
+    fn sum(self, other: Self) -> Self {
+        self + other
+    }
+    fn difference(self, other: Self) -> Self {
+        self - other
+    }
+    fn product(self, other: Self) -> Self {
+        self * other
+    }
+    fn magnitude(self) -> f64 {
+        Complex64::norm(self)
+    }
+    fn conjugate(self) -> Self {
+        Complex64::conj(&self)
+    }
+}
+
+// ---------------------------------------------------------------------------
+// RRQR per-step sequence
+// ---------------------------------------------------------------------------
+
+fn run_rrqr(case: &str, m: usize, n: usize, complex: bool) {
+    if !wanted(case) {
+        return;
+    }
+    let mut backend = backend();
+    let mut rng = Rng::new(0x5151 + (m * 31 + n) as u64);
+    if complex {
+        let values: Vec<num_complex::Complex64> = (0..m * n)
+            .map(|_| rng.c64() + num_complex::Complex64::new(0.75, 0.25))
+            .collect();
+        rrqr_typed::<num_complex::Complex64>(&mut backend, case, m, n, values);
+    } else {
+        let values: Vec<f64> = (0..m * n).map(|_| rng.f64() + 0.75).collect();
+        rrqr_typed::<f64>(&mut backend, case, m, n, values);
+    }
+}
+
+/// One full per-step factorization per iteration: exactly the launch sequence of
+/// `rank_revealing_qr_typed` — initialize the permutation, then for every step
+/// norms, pivot, swap, reflector and the trailing update, then extract R,
+/// initialize Q, apply the reflectors to Q in reverse and compute the rank.
+///
+/// The input clone the host function performs before the loop is a device-to-device
+/// memcpy, not a kernel, and is excluded on both sides, so the compared quantity is
+/// the per-step kernel sequence. Nothing restores the work buffer between iterations:
+/// the measured region starts from this reference-check factorization's leftover work
+/// matrix, and each iteration factorizes the previous iteration's leftover.
+fn rrqr_typed<T>(backend: &mut CudaBackend, case: &str, m: usize, n: usize, values: Vec<T>)
+where
+    T: CudaRrqrScalar + RrqrTensorVariant + Scalar + BenchScalar,
+    <T as LinalgScalar>::Real: Scalar,
+{
+    let k = m.min(n);
+    let options = RankRevealingQrOptions::default();
+    let work = placed(backend, vec![m, n], values.clone());
+    let work_typed = typed::<T>(&work);
+    let imaginary_unit = with_cuda_exec(backend, |exec| T::device_imaginary_unit(exec)).unwrap();
+    let runtime = backend.runtime().clone();
+    let launches = 1 + k * 5 - 1 + 1 + 1 + k + 1;
+
+    let (q, r, permutation, scratch_bytes) = with_cuda_exec(backend, |exec| {
+        exec.with_cubecl("bench_rrqr", |cubecl| {
+            // Every buffer is allocated once, outside the capture range.
+            let coeff = cubecl.alloc_output::<T>(&vec![k])?;
+            let norms = cubecl.alloc_output::<<T as LinalgScalar>::Real>(&vec![n])?;
+            let pivots = cubecl.alloc_output::<i64>(&[1])?;
+            let status = cubecl.alloc_zero_output::<i64>(&[k])?;
+            let rank = cubecl.alloc_output::<i64>(&[1])?;
+            let permutation = cubecl.alloc_output::<i64>(&[n])?;
+            let q = cubecl.alloc_output::<T>(&[m, k])?;
+            let r = cubecl.alloc_output::<T>(&[k, n])?;
+            // One extra output set for the single reference-checked run, so the
+            // measured iterations do not overwrite what the check reads.
+            let check_permutation = cubecl.alloc_output::<i64>(&[n])?;
+            let check_q = cubecl.alloc_output::<T>(&[m, k])?;
+            let check_r = cubecl.alloc_output::<T>(&[k, n])?;
+            let scratch_bytes = coeff.n_elements() * std::mem::size_of::<T>()
+                + norms.n_elements() * std::mem::size_of::<<T as LinalgScalar>::Real>()
+                + (pivots.n_elements() + status.n_elements() + rank.n_elements() + permutation.n_elements())
+                    * 8
+                + (q.n_elements() + r.n_elements() + check_q.n_elements() + check_r.n_elements())
+                    * std::mem::size_of::<T>()
+                + check_permutation.n_elements() * 8;
+
+            let batch_planes = rrqr_cube_count(1)?;
+
+            let sequence = |q: &TypedTensor<T>,
+                            r: &TypedTensor<T>,
+                            rank: &TypedTensor<i64>,
+                            permutation: &TypedTensor<i64>| {
+                for step in 0..k {
+                    let norm_planes = rrqr_cube_count(n - step).unwrap();
+                    T::launch_norms(cubecl, work_typed, &norms, norm_planes, step, m, n).unwrap();
+                    T::launch_pivot(
+                        cubecl,
+                        &norms,
+                        permutation,
+                        &pivots,
+                        &status,
+                        batch_planes.clone(),
+                        step,
+                        n,
+                    )
+                    .unwrap();
+                    launch_swap_columns(cubecl, work_typed, permutation, &pivots, step, m, n, 1)
+                        .unwrap();
+                    T::launch_reflector(
+                        cubecl,
+                        work_typed,
+                        &coeff,
+                        batch_planes.clone(),
+                        step,
+                        m,
+                        n,
+                        k,
+                    )
+                    .unwrap();
+                    let trailing = n - step - 1;
+                    if trailing > 0 {
+                        let apply_planes = rrqr_cube_count(trailing).unwrap();
+                        T::launch_apply(
+                            cubecl,
+                            work_typed,
+                            work_typed,
+                            &coeff,
+                            imaginary_unit.as_ref(),
+                            apply_planes,
+                            step,
+                            step + 1,
+                            trailing,
+                            m,
+                            n,
+                            n,
+                            k,
+                        )
+                        .unwrap();
+                    }
+                }
+                launch_extract_r(cubecl, work_typed, r, m, n, k).unwrap();
+                launch_initialize_q(cubecl, q, m, k).unwrap();
+                for step in (0..k).rev() {
+                    let q_planes = rrqr_cube_count(k).unwrap();
+                    T::launch_apply(
+                        cubecl,
+                        work_typed,
+                        q,
+                        &coeff,
+                        imaginary_unit.as_ref(),
+                        q_planes,
+                        step,
+                        0,
+                        k,
+                        m,
+                        n,
+                        k,
+                        k,
+                    )
+                    .unwrap();
+                }
+                T::launch_rank(cubecl, r, rank, &status, batch_planes.clone(), k, n, options)
+                    .unwrap();
+            };
+
+            // One reference-checked factorization before the capture range: the
+            // outputs must reconstruct A P = Q R, so a mis-wired launch sequence
+            // is not silently benchmarked.
+            launch_initialize_permutation(cubecl, &check_permutation, n)?;
+            sequence(&check_q, &check_r, &rank, &check_permutation);
+            runtime.synchronize().expect("check synchronize");
+
+            let mut run = || {
+                launch_initialize_permutation(cubecl, &permutation, n).unwrap();
+                sequence(&q, &r, &rank, &permutation);
+            };
+            measure(&runtime, &mut run);
+            Ok((
+                Tensor::from_typed::<T>(check_q),
+                Tensor::from_typed::<T>(check_r),
+                Tensor::from_typed::<i64>(check_permutation),
+                scratch_bytes,
+            ))
+        })
+        .unwrap()
+    });
+
+    let q_host: Vec<T> = downloaded(&runtime, &q);
+    let r_host: Vec<T> = downloaded(&runtime, &r);
+    let perm: Vec<i64> = downloaded(&runtime, &permutation);
+    let check = if reconstruction_ok::<T>(&values, &q_host, &r_host, &perm, m, n, k) {
+        "ok"
+    } else {
+        "FAIL"
+    };
+    emit_meta(
+        case,
+        "rrqr_initialize_permutation|rrqr_column_norms|rrqr_select_pivot|rrqr_swap_columns|\
+         rrqr_reflector|rrqr_apply_reflector|rrqr_extract_r|rrqr_initialize_q|rrqr_prefix_rank",
+        launches,
+        scratch_bytes,
+        check,
+    );
+}
+
+/// `A[.., permutation] == Q R` in the Frobenius norm, relative to `||A||`.
+fn reconstruction_ok<T: BenchScalar>(
+    a: &[T],
+    q: &[T],
+    r: &[T],
+    permutation: &[i64],
+    m: usize,
+    n: usize,
+    k: usize,
+) -> bool {
+    if permutation.len() != n || q.len() != m * k || r.len() != k * n {
+        return false;
+    }
+    let mut residual = 0.0f64;
+    let mut scale = 0.0f64;
+    for i in 0..m {
+        for j in 0..n {
+            let mut sum = T::zero();
+            for l in 0..k {
+                sum = BenchScalar::sum(
+                    sum,
+                    BenchScalar::product(q[i + l * m], r[l + j * k]),
+                );
+            }
+            let original = a[i + (permutation[j] as usize) * m];
+            let difference = BenchScalar::difference(sum, original);
+            residual += BenchScalar::magnitude(difference).powi(2);
+            scale += BenchScalar::magnitude(original).powi(2);
+        }
+    }
+    residual.sqrt() <= 1e-8 * scale.sqrt().max(1.0)
+}
+
+// ---------------------------------------------------------------------------
+// LU apply-pivots
+// ---------------------------------------------------------------------------
+
+fn run_lu_apply_pivots(case: &str, side: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let mut backend = backend();
+    let mut rng = Rng::new(0x6060);
+    let values: Vec<f64> = (0..side * side).map(|_| rng.f64()).collect();
+    let input = placed(&backend, vec![side, side], values.clone());
+    // Identity pivots (1-based, LAPACK order), so the apply is a bit-exact copy.
+    let pivots: Vec<i32> = (0..side).map(|index| index as i32 + 1).collect();
+    let pivots_tensor = placed(&backend, vec![side], pivots);
+    let runtime = backend.runtime().clone();
+
+    let out = with_cuda_exec(&mut backend, |exec| {
+        exec.with_cubecl("bench_lu_apply_pivots", |cubecl| {
+            let out = cubecl.alloc_output::<f64>(&[side, side])?;
+            let out_arg = unsafe { cubecl.tensor_binding(&out, "bench") }?;
+            let input_arg = unsafe { cubecl.tensor_binding(typed::<f64>(&input), "bench") }?;
+            let count = cubecl.cube_count_1d(out.n_elements())?;
+            let mut run = || unsafe {
+                // The pivot vector is a raw `&[i32]` argument; the array
+                // argument has no clone, so it is rebuilt per iteration from
+                // the same device buffer (host-side validation only).
+                let pivots_arg = cubecl
+                    .array_arg(typed::<i32>(&pivots_tensor), "bench")
+                    .unwrap();
+                cubecl_linalg::lu_apply_pivots::launch_unchecked::<f64>(
+                    cubecl.client(),
+                    count.clone(),
+                    cubecl.cube_dim_1d(),
+                    out_arg.clone().into_tensor_arg(),
+                    input_arg.clone().into_tensor_arg(),
+                    pivots_arg,
+                    side,
+                    2usize,
+                    false,
+                );
+            };
+            run();
+            runtime.synchronize().expect("check synchronize");
+            measure(&runtime, &mut run);
+            Ok(Tensor::from_typed::<f64>(out))
+        })
+        .unwrap()
+    });
+    let got: Vec<f64> = downloaded(&runtime, &out);
+    let check = if got == values { "ok" } else { "FAIL" };
+    emit_meta(case, "lu_apply_pivots", 1, 0, check);
+}
+
+// ---------------------------------------------------------------------------
+// QR phase + apply-phase
+// ---------------------------------------------------------------------------
+
+/// The real and complex QR phase application differ in the kernel they launch
+/// and in whether R takes the conjugate phase.
+trait QrPhaseOps: LinalgScalar + TensorScalar + Scalar + BenchScalar + 'static {
+    fn launch_phase(
+        client: &cubecl::client::Client,
+        count: CubeCount,
+        phase: TensorBinding,
+        r: TensorBinding,
+        rank: usize,
+    );
+    fn launch_apply(
+        client: &cubecl::client::Client,
+        count: CubeCount,
+        q: TensorBinding,
+        r: TensorBinding,
+        phase: TensorBinding,
+        rank: usize,
+    );
+    /// The phase the kernel computes for one R diagonal entry.
+    fn phase(diagonal: Self) -> Self;
+    /// Whether R takes the conjugate phase (complex only).
+    fn conjugate_r() -> bool;
+    const KERNELS: &'static str;
+}
+
+impl QrPhaseOps for f64 {
+    fn launch_phase(
+        client: &cubecl::client::Client,
+        count: CubeCount,
+        phase: TensorBinding,
+        r: TensorBinding,
+        rank: usize,
+    ) {
+        // SAFETY: both bindings describe live device tensors of this call.
+        unsafe {
+            cubecl_linalg::qr_phase_real::launch_unchecked::<f64>(
+                client,
+                count,
+                CubeDim::new_1d(256),
+                phase.into_tensor_arg(),
+                r.into_tensor_arg(),
+                rank,
+            );
+        }
+    }
+
+    fn launch_apply(
+        client: &cubecl::client::Client,
+        count: CubeCount,
+        q: TensorBinding,
+        r: TensorBinding,
+        phase: TensorBinding,
+        rank: usize,
+    ) {
+        // SAFETY: all bindings describe live device tensors of this call.
+        unsafe {
+            cubecl_linalg::qr_apply_phase_real::launch_unchecked::<f64>(
+                client,
+                count,
+                CubeDim::new_1d(256),
+                q.into_tensor_arg(),
+                r.into_tensor_arg(),
+                phase.into_tensor_arg(),
+                0usize,
+                rank,
+            );
+        }
+    }
+
+    fn phase(diagonal: Self) -> Self {
+        if diagonal < 0.0 {
+            -1.0
+        } else {
+            1.0
+        }
+    }
+
+    fn conjugate_r() -> bool {
+        false
+    }
+
+    const KERNELS: &'static str = "qr_phase_real|qr_apply_phase_real";
+}
+
+impl QrPhaseOps for num_complex::Complex64 {
+    fn launch_phase(
+        client: &cubecl::client::Client,
+        count: CubeCount,
+        phase: TensorBinding,
+        r: TensorBinding,
+        rank: usize,
+    ) {
+        // SAFETY: both bindings describe live device tensors of this call.
+        unsafe {
+            cubecl_linalg::qr_phase_c64::launch_unchecked(
+                client,
+                count,
+                CubeDim::new_1d(256),
+                phase.into_tensor_arg(),
+                r.into_tensor_arg(),
+                rank,
+            );
+        }
+    }
+
+    fn launch_apply(
+        client: &cubecl::client::Client,
+        count: CubeCount,
+        q: TensorBinding,
+        r: TensorBinding,
+        phase: TensorBinding,
+        rank: usize,
+    ) {
+        // SAFETY: all bindings describe live device tensors of this call.
+        unsafe {
+            cubecl_linalg::qr_apply_phase_complex::launch_unchecked::<num_complex::Complex64>(
+                client,
+                count,
+                CubeDim::new_1d(256),
+                q.into_tensor_arg(),
+                r.into_tensor_arg(),
+                phase.into_tensor_arg(),
+                0usize,
+                rank,
+            );
+        }
+    }
+
+    fn phase(diagonal: Self) -> Self {
+        let magnitude = Complex64::norm(diagonal);
+        if magnitude == 0.0 {
+            num_complex::Complex64::new(1.0, 0.0)
+        } else {
+            diagonal / num_complex::Complex64::new(magnitude, 0.0)
+        }
+    }
+
+    fn conjugate_r() -> bool {
+        true
+    }
+
+    const KERNELS: &'static str = "qr_phase_c64|qr_apply_phase_complex";
+}
+
+fn run_qr_apply_phase<T>(case: &str, rows: usize, cols: usize, q_values: Vec<T>, r_values: Vec<T>)
+where
+    T: QrPhaseOps,
+{
+    if !wanted(case) {
+        return;
+    }
+    let mut backend = backend();
+    let q_tensor = placed(&backend, vec![rows, cols], q_values.clone());
+    let r_tensor = placed(&backend, vec![cols, cols], r_values.clone());
+    let runtime = backend.runtime().clone();
+
+    let (q, r) = with_cuda_exec(&mut backend, |exec| {
+        exec.with_cubecl("bench_qr_apply_phase", |cubecl| {
+            let phase = cubecl.alloc_output::<T>(&[cols])?;
+            let q_arg = unsafe { cubecl.tensor_binding(typed::<T>(&q_tensor), "bench") }?;
+            let r_arg = unsafe { cubecl.tensor_binding(typed::<T>(&r_tensor), "bench") }?;
+            let phase_arg = unsafe { cubecl.tensor_binding(&phase, "bench") }?;
+            let phase_count = cubecl.cube_count_1d(phase.n_elements())?;
+            let apply_count = cubecl.cube_count_1d((rows * cols).max(cols * cols))?;
+            let mut run = || {
+                T::launch_phase(
+                    cubecl.client(),
+                    phase_count.clone(),
+                    phase_arg.clone(),
+                    r_arg.clone(),
+                    2usize,
+                );
+                T::launch_apply(
+                    cubecl.client(),
+                    apply_count.clone(),
+                    q_arg.clone(),
+                    r_arg.clone(),
+                    phase_arg.clone(),
+                    2usize,
+                );
+            };
+            run();
+            runtime.synchronize().expect("check synchronize");
+            measure(&runtime, &mut run);
+            Ok((q_tensor, r_tensor))
+        })
+        .unwrap()
+    });
+
+    // Expected: every Q column and every R row is scaled by the phase of the
+    // initial R diagonal; the complex kernel conjugates the phase on R.
+    let q_host: Vec<T> = downloaded(&runtime, &q);
+    let r_host: Vec<T> = downloaded(&runtime, &r);
+    let mut ok = q_host.len() == rows * cols && r_host.len() == cols * cols;
+    let row_phase = |i: usize| {
+        let phase = T::phase(r_values[i + i * cols]);
+        if T::conjugate_r() {
+            BenchScalar::conjugate(phase)
+        } else {
+            phase
+        }
+    };
+    for j in 0..cols {
+        let column_phase = T::phase(r_values[j + j * cols]);
+        for i in 0..rows {
+            let expected = BenchScalar::product(q_values[i + j * rows], column_phase);
+            if BenchScalar::magnitude(BenchScalar::difference(q_host[i + j * rows], expected))
+                > 1e-12
+            {
+                ok = false;
+            }
+        }
+        for i in 0..cols {
+            let expected = BenchScalar::product(r_values[i + j * cols], row_phase(i));
+            if BenchScalar::magnitude(BenchScalar::difference(r_host[i + j * cols], expected))
+                > 1e-12
+            {
+                ok = false;
+            }
+        }
+    }
+    emit_meta(
+        case,
+        T::KERNELS,
+        2,
+        cols * std::mem::size_of::<T>(),
+        if ok { "ok" } else { "FAIL" },
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Householder explicit V
+// ---------------------------------------------------------------------------
+
+fn run_householder_explicit_v<T>(case: &str, rows: usize, cols: usize, values: Vec<T>)
+where
+    T: LinalgScalar + TensorScalar + Scalar + BenchScalar,
+{
+    if !wanted(case) {
+        return;
+    }
+    let mut backend = backend();
+    let packed = placed(&backend, vec![rows, cols], values.clone());
+    let runtime = backend.runtime().clone();
+    let out = with_cuda_exec(&mut backend, |exec| {
+        exec.with_cubecl("bench_householder_explicit_v", |cubecl| {
+            let out = cubecl.alloc_output::<T>(&[rows, cols])?;
+            let out_arg = unsafe { cubecl.tensor_binding(&out, "bench") }?;
+            let packed_arg = unsafe { cubecl.tensor_binding(typed::<T>(&packed), "bench") }?;
+            let count = cubecl.cube_count_1d(out.n_elements())?;
+            let mut run = || unsafe {
+                cubecl_linalg::householder_explicit_v::launch_unchecked::<T>(
+                    cubecl.client(),
+                    count.clone(),
+                    cubecl.cube_dim_1d(),
+                    out_arg.clone().into_tensor_arg(),
+                    packed_arg.clone().into_tensor_arg(),
+                );
+            };
+            run();
+            runtime.synchronize().expect("check synchronize");
+            measure(&runtime, &mut run);
+            Ok(Tensor::from_typed::<T>(out))
+        })
+        .unwrap()
+    });
+    let got: Vec<T> = downloaded(&runtime, &out);
+    let mut ok = got.len() == rows * cols;
+    for i in 0..rows {
+        for j in 0..cols {
+            let expected = if i < j {
+                0.0
+            } else if i == j {
+                1.0
+            } else {
+                BenchScalar::magnitude(values[i + j * rows])
+            };
+            if (BenchScalar::magnitude(got[i + j * rows]) - expected).abs() > 1e-12 {
+                ok = false;
+            }
+        }
+    }
+    emit_meta(
+        case,
+        "householder_explicit_v",
+        1,
+        0,
+        if ok { "ok" } else { "FAIL" },
+    );
+}
