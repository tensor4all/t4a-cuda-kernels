+/// Cold prepare of the fused chain: a fresh runtime compiles the generated
+/// kernel on the first call and 10 warm calls reuse it. The baseline has no
+/// compile-count hook (`docs/design/cubecl-011-compile-count-hook.md`), so only
+/// the wall time is observable on this side.
+fn run_fused_cold_compile(case: &str) {
+    if !wanted(case) {
+        return;
+    }
+    let len = 10_000usize;
+    let backend = backend();
+    let plan = fusion_plan_chain();
+    let host: Vec<f32> = (0..len).map(|index| index as f32 * 1e-6).collect();
+    let host_tensor =
+        Tensor::from_typed::<f32>(TypedTensor::from_vec_col_major(vec![len], host).unwrap());
+    let input = crate::cuda::upload_tensor(backend.runtime(), &host_tensor).unwrap();
+
+    let cold_start = std::time::Instant::now();
+    let outputs = fusion::execute_elementwise_fusion(&backend, &[&input], &plan)
+        .unwrap()
+        .expect("eligible fusion plan");
+    backend.runtime().synchronize().unwrap();
+    let cold = cold_start.elapsed();
+    drop(outputs);
+
+    let warm_start = std::time::Instant::now();
+    for _ in 0..10 {
+        let outputs = fusion::execute_elementwise_fusion(&backend, &[&input], &plan)
+        .unwrap()
+        .expect("eligible fusion plan");
+        backend.runtime().synchronize().unwrap();
+        drop(outputs);
+    }
+    let warm = warm_start.elapsed() / 10;
+
+    println!(
+        "BENCH_META case={case} kernels=tenferro_fused_elementwise launches_per_iter=1 \
+         scratch_bytes=0 host_waits_per_iter=10 transfer_bytes_per_iter=0 \
+         device_allocations_per_iter=1 zero_fills_per_iter=0 boundary_barriers=0 check=n/a"
+    );
+    // The baseline has no compile-count hook (the tenferro-rs design records the
+    // missing observation hook), so only the wall times are observable here.
+    println!(
+        "BENCH_PREPARE case={case} emits=not_observable compile_attempts=not_observable \
+         module_loads=not_observable cache_hits=not_observable cache_misses=not_observable \
+         cold_ms={:.3} cold_compile_ms=not_observable cold_load_ms=not_observable warm_ms={:.3}",
+        cold.as_secs_f64() * 1e3,
+        warm.as_secs_f64() * 1e3
+    );
+    let mut run = || {
+        let outputs = fusion::execute_elementwise_fusion(&backend, &[&input], &plan)
+        .unwrap()
+        .expect("eligible fusion plan");
+        std::hint::black_box(&outputs);
+    };
+    measure(backend.runtime(), &mut run);
+}
