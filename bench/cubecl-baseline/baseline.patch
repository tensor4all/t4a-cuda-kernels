+#[derive(Clone, Copy)]
+struct Tile {
+    tile: usize,
+    block_rows: usize,
+    padding: usize,
+    vector_width: usize,
+}
+
+impl Tile {
+    const DEFAULT: Tile = Tile {
+        tile: 16,
+        block_rows: 8,
+        padding: 1,
+        vector_width: 1,
+    };
+
+    fn grid(&self, dst_fast: usize, src_fast: usize, batches: usize) -> (CubeCount, CubeDim) {
+        (
+            CubeCount::Static(
+                dst_fast.div_ceil(self.tile) as u32,
+                src_fast.div_ceil(self.tile) as u32,
+                batches as u32,
+            ),
+            CubeDim::new_2d(
+                (self.tile / self.vector_width) as u32,
+                self.block_rows as u32,
+            ),
+        )
+    }
+}
+
+/// Compact F32 copy: the baseline's exact copy is the materialize kernel with
+/// identity strides.
+fn run_copy_f32(case: &str, side: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let len = side * side;
+    let mut rng = Rng::new(0xBBBB_CCCC);
+    let values: Vec<f32> = (0..len).map(|_| rng.f32()).collect();
+    let src = upload(client, &values);
+    let dst = client.empty(len * 4);
+    let shape = [side, side];
+    let strides = [1i64, side as i64];
+    let (count, dim) = flat(len);
+    let mut run = || unsafe {
+        kernels::structural::materialize_strided_kernel::launch_unchecked::<f32>(
+            client,
+            count.clone(),
+            dim,
+            arg(&dst, len),
+            arg(&src, len),
+            runtime_sequence(&shape),
+            runtime_sequence(&strides),
+            0i64,
+            len,
+            2usize,
+        );
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<f32>(client, &dst, len);
+    checked(got == values, case);
+    measure(backend.runtime(), &mut run);
+    emit_meta(case, &Meta::simple("materialize_strided_kernel"), "ok", "");
+}
+
+fn run_tiled_transpose(
+    case: &str,
+    tile: Tile,
+    dst_fast: usize,
+    src_fast: usize,
+    batches: usize,
+    src_offset: usize,
+) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
+    let client = client(&backend);
+    let matrix = dst_fast * src_fast;
+    let span = matrix * batches;
+    let mut rng = Rng::new(0xDDDD_EEEE + src_offset as u64);
+    // A non-zero source offset is an offset into the source allocation, not a
+    // shifted copy of it.
+    let values: Vec<f32> = (0..span + src_offset).map(|_| rng.f32()).collect();
+    let src = upload(client, &values);
+    let dst = client.empty(span * 4);
+    let (count, dim) = tile.grid(dst_fast, src_fast, batches);
+    let mut run = || unsafe {
+        kernels::structural::tiled_transpose_kernel::launch_unchecked::<f32>(
+            client,
+            count.clone(),
+            dim,
+            arg(&dst, span),
+            arg(&src, span + src_offset),
+            src_offset,
+            matrix,
+            dst_fast,
+            src_fast,
+            tile.tile,
+            tile.block_rows,
+            tile.padding,
+            tile.vector_width,
+        );
+    };
+    run();
+    backend.runtime().synchronize().unwrap();
+    let got = read::<f32>(client, &dst, span);
+    let mut ok = true;
+    for batch in 0..batches {
+        for i in 0..dst_fast {
+            for j in 0..src_fast {
+                let expected = values[src_offset + batch * matrix + i * src_fast + j];
+                let actual = got[batch * matrix + i + j * dst_fast];
+                if !close_f32(actual, expected) {
+                    ok = false;
+                }
+            }
+        }
+    }
+    checked(ok, case);
+    measure(backend.runtime(), &mut run);
+    emit_meta(
+        case,
+        &Meta {
+            kernels: "tiled_transpose_kernel",
+            launches: 1,
+            scratch_bytes: tile.tile * (tile.tile + tile.padding) * 4,
+            allocations: 0,
+            zero_fills: 0,
+        },
+        "ok",
+        "",
+    );
+}
+
+fn run_materialize_negative_stride(case: &str, side: usize) {
+    if !wanted(case) {
+        return;
+    }
+    let backend = backend();
