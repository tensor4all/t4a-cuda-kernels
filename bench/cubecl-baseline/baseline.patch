+#[test]
+#[ignore = "requires CUDA and an idle GPU"]
+fn bench_tenferro_linalg() {
+    assert!(tenferro_gpu::cuda::gpu_available(), "CUDA device required");
+    let cases = std::env::var("T4A_BENCH_CASES").unwrap_or_else(|_| "all".to_string());
+    println!("BENCH_CASES requested={cases}");
+
+    run_rrqr("linalg-rrqr-256x256-f64", 256, 256, false);
+    run_rrqr("linalg-rrqr-256x256-c64", 256, 256, true);
+    run_rrqr("linalg-rrqr-1024x256-f64", 1024, 256, false);
+    run_rrqr("linalg-rrqr-1024x256-c64", 1024, 256, true);
+    run_lu_apply_pivots("linalg-lu-apply-pivots-1024-f64", 1024);
+
+    let rows = 1024usize;
+    let cols = 256usize;
+    let mut rng = Rng::new(0x7070);
+    // Upper-triangular R with alternating diagonal signs, so both real phases
+    // and a spread of complex phases occur.
+    let mut r_real = vec![0.0f64; cols * cols];
+    let mut r_complex = vec![num_complex::Complex64::new(0.0, 0.0); cols * cols];
+    for j in 0..cols {
+        for i in 0..=j {
+            if i == j {
+                let magnitude = 2.0 + i as f64;
+                r_real[i + j * cols] = if i % 2 == 0 { magnitude } else { -magnitude };
+                r_complex[i + j * cols] = num_complex::Complex64::new(magnitude, 0.5);
+            } else {
+                r_real[i + j * cols] = rng.f64();
+                r_complex[i + j * cols] = rng.c64();
+            }
+        }
+    }
+    run_qr_apply_phase(
+        "linalg-qr-apply-phase-1024x256-f64",
+        rows,
+        cols,
+        (0..rows * cols).map(|_| rng.f64()).collect(),
+        r_real,
+    );
+    run_qr_apply_phase(
+        "linalg-qr-apply-phase-1024x256-c64",
+        rows,
+        cols,
+        (0..rows * cols).map(|_| rng.c64()).collect(),
+        r_complex,
+    );
+
+    let mut rng = Rng::new(0x8080);
+    run_householder_explicit_v(
+        "linalg-householder-explicit-v-1024x256-f64",
+        rows,
+        cols,
+        (0..rows * cols).map(|_| rng.f64()).collect(),
+    );
+    let mut rng = Rng::new(0x8081);
+    run_householder_explicit_v(
+        "linalg-householder-explicit-v-1024x256-c64",
+        rows,
+        cols,
+        (0..rows * cols).map(|_| rng.c64()).collect(),
+    );
+}
