	//## include/t4a/abi.cuh:775
        /*39fa0*/               @P2 BRA `(.L_x_5343) ;
	//## src/reduce.cu:253
        /*39fd0*/                   LDG.E.64 R6, [R2.64] ;
	//## include/t4a/abi.cuh:775
	//## include/t4a/abi.cuh:778
        /*3a000*/                   DSETP.NAN.AND P2, PT, R6, R6, PT ;
	//## include/t4a/abi.cuh:781
        /*3a020*/              @!P2 DSETP.MIN.AND P3, P4, R6, R2, PT ;
        /*3a050*/              @!P2 FSEL R27, R2, R3, P3 ;
	//## include/t4a/abi.cuh:778
	//## include/t4a/abi.cuh:781
        /*3a0c0*/                   BSYNC B2 ;
	//## src/reduce.cu:252
        /*3a100*/               @P0 BRA `(.L_x_5344) ;
        /*3a110*/                   BSYNC B1 ;
	//## include/t4a/abi.cuh:775
        /*3a140*/              @!P0 BRA `(.L_x_5336) ;
        /*3a250*/                   DSETP.NAN.AND P0, PT, R20, R20, PT ;
        /*3a260*/                   BSSY B1, `(.L_x_5345) ;
        /*3a290*/               @P0 BRA `(.L_x_5346) ;
	//## src/reduce.cu:253
        /*3a2c0*/                   LDG.E.64 R2, [R2.64] ;
	//## include/t4a/abi.cuh:778
        /*3a2d0*/                   DSETP.NAN.AND P0, PT, R2, R2, PT ;
	//## include/t4a/abi.cuh:781
        /*3a2e0*/              @!P0 DSETP.MIN.AND P1, P2, R2, R20, PT ;
        /*3a320*/              @!P0 FSEL R10, R0, R7, P1 ;
        /*3a380*/                   BSYNC B1 ;
	//## include/t4a/abi.cuh:775
        /*3a390*/                   DSETP.NAN.AND P0, PT, R2, R2, PT ;
	//## src/reduce.cu:253
	//## include/t4a/abi.cuh:775

