# SASS of the *production* entry points, both trees, taken with source-line attribution.
#
# The earlier excerpt (sass-plane-loop.log) is `plane_reduce_body<MaxFold, float>` compiled
# alone in a probe kernel called `probe_max`; it shows the loop body but not where it ships.
# This file is the same claim taken on the global entry points themselves.
#
# $ nvcc -std=c++17 -cubin -arch=sm_80 -lineinfo -I cuda/include -o reduce.cubin cuda/src/reduce.cu
# $ nvcc -std=c++17 -cubin -arch=sm_80 -lineinfo -I cuda/include -o elementwise.cubin cuda/src/elementwise.cu
# $ nvdisasm -g -c -sf <cubin>        # -g prints one `//## File ..., line N` per instruction
# CUDA 12.6 (Build cuda_12.6.r12.6/compiler.35059454_0), the build the A100 campaign used.
# The base side is the same commands in a worktree of 3c8d82c.
#
# Run on evo2 (Ryzen AI MAX+ 395, no NVIDIA device, no driver): compiling and disassembling
# need no GPU, so this file is a per-instruction claim only. It measures nothing.
#
# Each excerpt starts with the raw `.section`/`.sectioninfo` header nvdisasm prints for the
# enclosing section, so the symbol it belongs to travels with the instructions. After the header,
# the excerpt keeps LDG/DSETP/FSETP/FSEL/FMNMX/BSSY/BSYNC/BRA and the line markers, and drops the
# address arithmetic and register moves between them.
#
# abi.cuh, this branch -> 3c8d82c:
#   t4a_cuda_nan_max(float)   748-751 -> 745-751
#   t4a_cuda_nan_min(float)   760-763 -> 765-771
#   t4a_cuda_nan_max(double)  754-757 -> 754-761
#   t4a_cuda_nan_min(double)  766-769 -> 774-781

## 1. `t4a_cuda_reduce` (cuda/src/reduce.cu:657), the combine pass's strided fold at
##    reduce.cu:252-253 inside plane_reduce_body (reduce.cu:251 loads the seed).
##    This is the entry the PR's pass-2 number comes from.

### 3c8d82c: one load per fold, behind a branch on the accumulator
	.section	.text.t4a_cuda_reduce,"ax",@progbits
	.sectionflags	@"SHF_BARRIERS=1"
	.sectioninfo	@"SHI_REGISTERS=40"
.text.t4a_cuda_reduce:
        /*39f30*/                   DSETP.NAN.AND P2, PT, R20, R20, PT ;
	//## src/reduce.cu:252
