## 2. `t4a_cuda_binary` (cuda/src/elementwise.cu:371), the elementwise `MAX`/`MIN` routes the
##    `sass-diff.sh` list names. Entry 0x12b0 is the float `MAX` arm (abi.cuh:749-751 here,
##    745-751 at 3c8d82c) and 0x1310 the float `MIN` arm.

### 3c8d82c: two branches per element pair
	.section	.text.t4a_cuda_binary,"ax",@progbits
	.sectioninfo	@"SHI_REGISTERS=38"
        .global         t4a_cuda_binary
.text.t4a_cuda_binary:
        /*1290*/                   BSYNC B0 ;
        /*12a0*/                   BRA `(.L_x_267) ;
	//## include/t4a/abi.cuh:745
        /*12b0*/                   FSETP.NAN.AND P0, PT, R0, R0, PT ;
        /*12c0*/                   BSSY B0, `(.L_x_272) ;
        /*12e0*/               @P0 BRA `(.L_x_273) ;
	//## include/t4a/abi.cuh:748
        /*12f0*/                   FSETP.NAN.AND P0, PT, R5, R5, PT ;
        /*1310*/               @P0 BRA `(.L_x_273) ;
	//## include/t4a/abi.cuh:751
        /*1320*/                   FMNMX R7, R0, R5, !PT ;
        /*1330*/                   BSYNC B0 ;
        /*1340*/                   BRA `(.L_x_267) ;
	//## include/t4a/abi.cuh:765
        /*1350*/                   FSETP.NAN.AND P0, PT, R0, R0, PT ;
        /*1360*/                   BSSY B0, `(.L_x_274) ;
        /*1380*/               @P0 BRA `(.L_x_275) ;
	//## include/t4a/abi.cuh:768
        /*1390*/                   FSETP.NAN.AND P0, PT, R5, R5, PT ;
        /*13b0*/               @P0 BRA `(.L_x_275) ;
	//## include/t4a/abi.cuh:771
        /*13c0*/                   FMNMX R7, R0, R5, PT ;
        /*13d0*/                   BSYNC B0 ;
        /*13e0*/                   BRA `(.L_x_267) ;
	//## src/elementwise.cu:184
        /*1440*/                   BRX R8 -0x1450                                                            (*"BRANCH_TARGETS .L_x_766,.L_x_767,.L_x_768"*);
        /*1470*/               @P0 BRA `(.L_x_267) ;
	//## src/elementwise.cu:201
        /*1490*/                   BSSY B2, `(.L_x_276) ;

