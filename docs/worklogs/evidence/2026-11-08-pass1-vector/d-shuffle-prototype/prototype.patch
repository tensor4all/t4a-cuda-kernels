+#[test]
+fn zz_dump_partials_for_topology_comparison() {
+    let Ok(path) = std::env::var("T4A_DUMP_PARTIALS") else {
+        return;
+    };
+    let session = Session::new("reduce");
+    let mut out = String::new();
+    for len in [1usize << 20, 1 << 24] {
+        let f32_values: Vec<f32> = (0..len as i64).map(f32::from_index).collect();
+        let f64_values: Vec<f64> = (0..len as i64).map(f64::from_index).collect();
+        let src32 = upload(&session, &f32_values);
+        let src64 = upload(&session, &f64_values);
+        for op in [ReduceOp::Sum, ReduceOp::Max, ReduceOp::SumSquares] {
+            let (partials, _, total) =
+                run_walk::<f32>(&session, &src32, len as i64, 0, len as i64, op, 32);
+            let bits: Vec<String> = partials.iter().map(|v| format!("{:08x}", v.to_bits())).collect();
+            out += &format!("f32 {op:?} {len} total {:08x} partials {}\n", total.to_bits(), bits.join(","));
+            let (partials, _, total) =
+                run_walk::<f64>(&session, &src64, len as i64, 0, len as i64, op, 32);
+            let bits: Vec<String> = partials.iter().map(|v| format!("{:016x}", v.to_bits())).collect();
+            out += &format!("f64 {op:?} {len} total {:016x} partials {}\n", total.to_bits(), bits.join(","));
+        }
+    }
+    std::fs::write(path, out).unwrap();
+}
