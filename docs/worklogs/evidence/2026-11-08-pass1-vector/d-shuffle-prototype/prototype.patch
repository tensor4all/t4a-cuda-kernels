+// PROTOTYPE (not for merge): revision-12 lane ownership with 16-byte loads. Lane `t` of a
+// 32-lane block owns chunk elements `t + 32k` in order, as in the serial walk; each lane loads
+// the 16-byte vector `stripe * 32 + lane` and the owner receives its element through
+// `__shfl_sync`, `V` shuffles per owned element (one per component, kept when it matches).
+// Requires a 16-byte-aligned chunk, plane width 32 and `len % (32 * V) == 0`.
+template <typename Fold, typename T>
+__device__ __noinline__ T t4a_proto_shuffle_walk(const T* chunk, long long len, Fold fold) {
+  constexpr int V = t4a_cuda_vector_lanes<T>::value;
+  constexpr int B = t4a_cuda_vector_batch;
+  using Vector = t4a_cuda_vector<T, V>;
+  const int lane = static_cast<int>(threadIdx.x);
+  const Vector* body = reinterpret_cast<const Vector*>(chunk);
+  const long long stripes = len / (32 * V);
+  const int part = lane % V;
+  const int source = lane / V;
+  T acc{};
+  bool seeded = false;
+  for (long long first = 0; first < stripes; first += B) {
+    Vector batch[B];
+#pragma unroll
+    for (int b = 0; b < B; ++b) {
+      if (first + b < stripes) {
+        batch[b] = body[(first + b) * 32 + lane];
+      }
+    }
+#pragma unroll
+    for (int b = 0; b < B; ++b) {
+      if (first + b < stripes) {
+#pragma unroll
+        for (int j = 0; j < V; ++j) {
+          T value{};
+#pragma unroll
+          for (int c = 0; c < V; ++c) {
+            const T got = __shfl_sync(0xFFFFFFFFu, batch[b].lane[c], source + (32 / V) * j);
+            if (c == part) {
+              value = got;
+            }
+          }
+          if (seeded) {
+            acc = fold(acc, value);
+          } else {
+            acc = fold.seed(value);
+            seeded = true;
+          }
+        }
+      }
+    }
+  }
+  return acc;
+}
