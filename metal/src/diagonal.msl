// t4a-cuda-kernels: the Metal diagonal module — extraction, embedding and the
// triangular masks (compact and layout-taking), for f32 and Complex32.
//
// The entry semantics are those of `cuda/src/diagonal.cu` in this repository, and
// therefore of tenferro-rs@14bc1ab933e3c7a9c966e08355670331ab9d993c
// `crates/tenferro-gpu/src/kernels/diagonal.rs: extract_diagonal_kernel (L5),
// embed_diagonal_copy_kernel (L33), tril_kernel (L61), triu_kernel (L75)` plus the
// revision-11 view twins. Copyright (c) 2026 Hiroshi Shinaoka and tenferro-rs
// contributors; MIT OR Apache-2.0.
//
// CORRECTION against the baseline, carried over from the CUDA port:
// extract_diagonal_kernel walks the output coordinate cursor over every
// non-diagonal input axis but never skips the diagonal output axis, so with
// rank >= 3 and a non-zero diagonal output position it reads a wrong input
// coordinate. This module implements the intended map (skip the diagonal output
// axis), and the caller derives that position as `axis_a - (axis_b < axis_a)`.

#include <t4a/abi.msl>

// --- diagonal extraction ---------------------------------------------------

// The output is compact over the input's extents without `axis_b`, with the
// diagonal length at `axis_a - (axis_b < axis_a)`. The quotient walk below skips
// the diagonal output axis while it consumes the output coordinates in axis order,
// so no per-axis coordinate array is needed.
kernel void t4a_metal_extract_diagonal(device uchar* out [[buffer(0)]],
                                       device const uchar* in [[buffer(1)]],
                                       constant int& dtype [[buffer(2)]],
                                       constant t4a_metal_layout& out_layout [[buffer(3)]],
                                       constant t4a_metal_layout& in_layout [[buffer(4)]],
                                       constant int& axis_a [[buffer(5)]],
                                       constant int& axis_b [[buffer(6)]],
                                       constant long& len [[buffer(7)]],
                                       uint index [[thread_position_in_grid]]) {
  if (!t4a_metal_reaches(index, len)) {
    return;
  }
  const int diag_axis = axis_a - (axis_b < axis_a ? 1 : 0);
  const long diagonal = t4a_metal_compact_coord((ulong)index, out_layout, diag_axis);

  long in_index = in_layout.offset;
  long rest = (long)index;
  int out_axis = 0;
  for (int axis = 0; axis < T4A_METAL_MAX_RANK; ++axis) {
    if (axis >= in_layout.rank) {
      break;
    }
    long coordinate;
    if (axis == axis_a || axis == axis_b) {
      coordinate = diagonal;
    } else {
      if (out_axis == diag_axis) {
        // The diagonal axis was decoded by itself, so its extent must be divided
        // out of the running quotient before the next output coordinate is read.
        rest /= out_layout.extents[out_axis];
        ++out_axis;
      }
      const long extent = out_layout.extents[out_axis];
      coordinate = rest % extent;
      rest /= extent;
      ++out_axis;
    }
    in_index += coordinate * in_layout.strides[axis];
  }
  t4a_metal_move_element(dtype, out, in, (long)index, in_index);
}

// --- diagonal embedding ----------------------------------------------------

// One thread per input element. The output must be zero-filled before the launch,
// because only the diagonal positions are written; `axis_b` is an insertion
// position in `[0, in.rank]`.
kernel void t4a_metal_embed_diagonal_copy(device uchar* out [[buffer(0)]],
                                          device const uchar* in [[buffer(1)]],
                                          constant int& dtype [[buffer(2)]],
                                          constant t4a_metal_layout& out_layout [[buffer(3)]],
                                          constant t4a_metal_layout& in_layout [[buffer(4)]],
                                          constant int& axis_a [[buffer(5)]],
                                          constant int& axis_b [[buffer(6)]],
                                          constant long& len [[buffer(7)]],
                                          uint index [[thread_position_in_grid]]) {
  if (!t4a_metal_reaches(index, len)) {
    return;
  }
  const long diagonal = t4a_metal_compact_coord((ulong)index, in_layout, axis_a);

  long out_index = out_layout.offset;
  long rest = (long)index;
  int in_axis = 0;
  for (int out_axis = 0; out_axis < T4A_METAL_MAX_RANK; ++out_axis) {
    if (out_axis >= out_layout.rank) {
      break;
    }
    long coordinate;
    if (out_axis == axis_b) {
      coordinate = diagonal;
    } else {
      const long extent = in_layout.extents[in_axis];
      coordinate = rest % extent;
      rest /= extent;
      ++in_axis;
    }
    out_index += coordinate * out_layout.strides[out_axis];
  }
  t4a_metal_move_element(dtype, out, in, out_index, (long)index);
}

// --- triangular masks ------------------------------------------------------

// Both operands are compact over the same extents; axes 0 and 1 carry the triangle
// and every higher axis batches it. `col - row` is compared with `k`, so an extreme
// `k` is well defined (the baseline's `col - k` was not).
static inline bool t4a_metal_keeps_triangle(long row, long col, long k, bool keep_below) {
  const long offset = col - row;
  return keep_below ? offset <= k : offset >= k;
}

static inline void t4a_metal_triangular(device uchar* out, device const uchar* in, int dtype,
                                        long k, long rows, long cols, long len, bool keep_below,
                                        uint index) {
  const long row = (long)index % rows;
  const long col = ((long)index / rows) % cols;
  if (t4a_metal_keeps_triangle(row, col, k, keep_below)) {
    t4a_metal_move_element(dtype, out, in, (long)index, (long)index);
    return;
  }
  t4a_metal_store_zero(dtype, out, (long)index);
}

kernel void t4a_metal_tril(device uchar* out [[buffer(0)]],
                           device const uchar* in [[buffer(1)]],
                           constant int& dtype [[buffer(2)]],
                           constant long& k [[buffer(3)]],
                           constant long& rows [[buffer(4)]],
                           constant long& cols [[buffer(5)]],
                           constant long& len [[buffer(6)]],
                           uint index [[thread_position_in_grid]]) {
  if (!t4a_metal_reaches(index, len)) {
    return;
  }
  t4a_metal_triangular(out, in, dtype, k, rows, cols, len, true, index);
}

kernel void t4a_metal_triu(device uchar* out [[buffer(0)]],
                           device const uchar* in [[buffer(1)]],
                           constant int& dtype [[buffer(2)]],
                           constant long& k [[buffer(3)]],
                           constant long& rows [[buffer(4)]],
                           constant long& cols [[buffer(5)]],
                           constant long& len [[buffer(6)]],
                           uint index [[thread_position_in_grid]]) {
  if (!t4a_metal_reaches(index, len)) {
    return;
  }
  t4a_metal_triangular(out, in, dtype, k, rows, cols, len, false, index);
}

// The view twins: one thread per output element, whose extents are the input's, so
// the same decode yields the mask's row and column and the input coordinates. The
// input is read through its layout only for a kept element; a masked element stores
// zero and touches no input address.
static inline void t4a_metal_triangular_view(device uchar* out, device const uchar* in, int dtype,
                                             constant t4a_metal_layout& in_layout, long k,
                                             long len, bool keep_below, uint index) {
  const long row = t4a_metal_compact_coord((ulong)index, in_layout, 0);
  const long col = t4a_metal_compact_coord((ulong)index, in_layout, 1);
  if (!t4a_metal_keeps_triangle(row, col, k, keep_below)) {
    t4a_metal_store_zero(dtype, out, (long)index);
    return;
  }
  t4a_metal_move_element(dtype, out, in, (long)index, t4a_metal_decode(index, in_layout));
}

kernel void t4a_metal_tril_view(device uchar* out [[buffer(0)]],
                                device const uchar* in [[buffer(1)]],
                                constant int& dtype [[buffer(2)]],
                                constant t4a_metal_layout& in_layout [[buffer(3)]],
                                constant long& k [[buffer(4)]],
                                constant long& len [[buffer(5)]],
                                uint index [[thread_position_in_grid]]) {
  if (!t4a_metal_reaches(index, len)) {
    return;
  }
  t4a_metal_triangular_view(out, in, dtype, in_layout, k, len, true, index);
}

kernel void t4a_metal_triu_view(device uchar* out [[buffer(0)]],
                                device const uchar* in [[buffer(1)]],
                                constant int& dtype [[buffer(2)]],
                                constant t4a_metal_layout& in_layout [[buffer(3)]],
                                constant long& k [[buffer(4)]],
                                constant long& len [[buffer(5)]],
                                uint index [[thread_position_in_grid]]) {
  if (!t4a_metal_reaches(index, len)) {
    return;
  }
  t4a_metal_triangular_view(out, in, dtype, in_layout, k, len, false, index);
}
